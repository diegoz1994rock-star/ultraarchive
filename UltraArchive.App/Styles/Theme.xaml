<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         UltraArchive — identidad visual "gestor de archivos premium":
         azul marino / grafito, acentos azul-cian sobrios, glass sutil.
         Solo capa visual: no toca lógica ni estructura.
         ============================================================ -->

    <!-- Paleta -->
    <Color x:Key="UA.Color.BgDeep">#0B111E</Color>
    <Color x:Key="UA.Color.BgBase">#0F1626</Color>
    <Color x:Key="UA.Color.BgPanel">#141D30</Color>
    <Color x:Key="UA.Color.BgElevated">#1B2740</Color>
    <Color x:Key="UA.Color.BgHover">#213052</Color>
    <Color x:Key="UA.Color.BgInput">#0C1424</Color>
    <Color x:Key="UA.Color.Stroke">#26324F</Color>
    <Color x:Key="UA.Color.StrokeSoft">#1B2540</Color>
    <Color x:Key="UA.Color.TextPrimary">#EAF0FA</Color>
    <Color x:Key="UA.Color.TextSecondary">#9FB0CC</Color>
    <Color x:Key="UA.Color.TextMuted">#5F708F</Color>
    <Color x:Key="UA.Color.Accent">#3E7DFF</Color>
    <Color x:Key="UA.Color.AccentHover">#5B93FF</Color>
    <Color x:Key="UA.Color.AccentPressed">#316AE0</Color>
    <Color x:Key="UA.Color.Cyan">#39C6E6</Color>
    <Color x:Key="UA.Color.Success">#3FB37F</Color>
    <Color x:Key="UA.Color.Warning">#D7A44A</Color>
    <Color x:Key="UA.Color.Danger">#E0655C</Color>

    <SolidColorBrush x:Key="UA.Brush.BgDeep" Color="{StaticResource UA.Color.BgDeep}" />
    <SolidColorBrush x:Key="UA.Brush.BgBase" Color="{StaticResource UA.Color.BgBase}" />
    <SolidColorBrush x:Key="UA.Brush.BgPanel" Color="{StaticResource UA.Color.BgPanel}" />
    <SolidColorBrush x:Key="UA.Brush.BgElevated" Color="{StaticResource UA.Color.BgElevated}" />
    <SolidColorBrush x:Key="UA.Brush.BgHover" Color="{StaticResource UA.Color.BgHover}" />
    <SolidColorBrush x:Key="UA.Brush.BgInput" Color="{StaticResource UA.Color.BgInput}" />
    <SolidColorBrush x:Key="UA.Brush.Stroke" Color="{StaticResource UA.Color.Stroke}" />
    <SolidColorBrush x:Key="UA.Brush.StrokeSoft" Color="{StaticResource UA.Color.StrokeSoft}" />
    <SolidColorBrush x:Key="UA.Brush.TextPrimary" Color="{StaticResource UA.Color.TextPrimary}" />
    <SolidColorBrush x:Key="UA.Brush.TextSecondary" Color="{StaticResource UA.Color.TextSecondary}" />
    <SolidColorBrush x:Key="UA.Brush.TextMuted" Color="{StaticResource UA.Color.TextMuted}" />
    <SolidColorBrush x:Key="UA.Brush.Accent" Color="{StaticResource UA.Color.Accent}" />
    <SolidColorBrush x:Key="UA.Brush.AccentHover" Color="{StaticResource UA.Color.AccentHover}" />
    <SolidColorBrush x:Key="UA.Brush.AccentPressed" Color="{StaticResource UA.Color.AccentPressed}" />
    <SolidColorBrush x:Key="UA.Brush.Cyan" Color="{StaticResource UA.Color.Cyan}" />
    <SolidColorBrush x:Key="UA.Brush.Danger" Color="{StaticResource UA.Color.Danger}" />
    <SolidColorBrush x:Key="UA.Brush.SelectionFill" Color="{StaticResource UA.Color.Accent}" Opacity="0.20" />
    <SolidColorBrush x:Key="UA.Brush.SelectionStroke" Color="{StaticResource UA.Color.Accent}" Opacity="0.55" />
    <SolidColorBrush x:Key="UA.Brush.HoverFill" Color="{StaticResource UA.Color.TextPrimary}" Opacity="0.055" />

    <!-- Fondo de ventana: degradado marino → grafito, con un halo tenue arriba a la izquierda. -->
    <LinearGradientBrush x:Key="UA.Brush.WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#111B2E" Offset="0" />
        <GradientStop Color="#0D1524" Offset="0.55" />
        <GradientStop Color="#0A111D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UA.Brush.Toolbar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#182338" Offset="0" />
        <GradientStop Color="#131C2E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UA.Brush.AccentButton" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A88FF" Offset="0" />
        <GradientStop Color="#3568E6" Offset="1" />
    </LinearGradientBrush>

    <system:Double x:Key="UA.FontSize.Small">12</system:Double>
    <FontFamily x:Key="UA.Font">Segoe UI Variable Text, Segoe UI, Inter, sans-serif</FontFamily>
    <CornerRadius x:Key="UA.Corner">8</CornerRadius>

    <!-- Sombras suaves -->
    <DropShadowEffect x:Key="UA.Shadow.Soft" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.38" Color="#04070E" />
    <DropShadowEffect x:Key="UA.Shadow.Card" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.30" Color="#04070E" />

    <!-- ============================================================
         Overrides de los recursos de WPF-UI (los usan sus plantillas
         vía DynamicResource): así botones, cajas de texto, combos,
         checkbox, titlebar, etc. adoptan la paleta sin re-templatizar.
         ============================================================ -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource UA.Color.BgBase}" />
    <SolidColorBrush x:Key="WindowBackgroundColorBrush" Color="{StaticResource UA.Color.BgBase}" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource UA.Color.TextPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource UA.Color.TextSecondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource UA.Color.TextMuted}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#41506B" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource UA.Color.TextMuted}" />

    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource UA.Color.AccentHover}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource UA.Color.AccentHover}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource UA.Color.Accent}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E8EEFF" />

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource UA.Color.Accent}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource UA.Color.AccentHover}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource UA.Color.AccentPressed}" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#2A3A5C" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource UA.Color.BgElevated}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource UA.Color.BgHover}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#182339" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#141D2E" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource UA.Color.BgInput}" />

    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="{StaticResource UA.Color.BgInput}" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="{StaticResource UA.Color.BgHover}" />
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="#2A3B5E" />
    <SolidColorBrush x:Key="ControlAltFillColorDisabledBrush" Color="Transparent" />

    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource UA.Color.BgHover}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#1A2740" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="Transparent" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource UA.Color.BgPanel}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource UA.Color.BgElevated}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource UA.Color.BgPanel}" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource UA.Color.BgElevated}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource UA.Color.BgBase}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource UA.Color.BgDeep}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource UA.Color.BgPanel}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource UA.Color.BgElevated}" />

    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource UA.Color.Stroke}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource UA.Color.StrokeSoft}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#3A4B70" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="#233150" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource UA.Color.Stroke}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="{StaticResource UA.Color.Stroke}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{StaticResource UA.Color.Stroke}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="{StaticResource UA.Color.Stroke}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource UA.Color.StrokeSoft}" />
    <SolidColorBrush x:Key="CardStrokeColorAccentBrush" Color="{StaticResource UA.Color.Accent}" />

    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{StaticResource UA.Color.Success}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{StaticResource UA.Color.Warning}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{StaticResource UA.Color.Danger}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{StaticResource UA.Color.Accent}" />

    <LinearGradientBrush x:Key="ControlElevationBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A4B70" Offset="0" />
        <GradientStop Color="#26324F" Offset="0.4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentControlElevationBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6DA0FF" Offset="0" />
        <GradientStop Color="#3568E6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CircleElevationBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A4B70" Offset="0" />
        <GradientStop Color="#26324F" Offset="1" />
    </LinearGradientBrush>

    <CornerRadius x:Key="ControlCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">9</CornerRadius>

    <!-- ============================================================
         Estilos propios de UltraArchive
         ============================================================ -->

    <!-- Tarjeta / panel elevado con borde y sombra suave -->
    <Style x:Key="UA.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UA.Brush.BgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource UA.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Effect" Value="{StaticResource UA.Shadow.Card}" />
    </Style>

    <!-- Barra superior de herramientas -->
    <Style x:Key="UA.Toolbar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UA.Brush.Toolbar}" />
        <Setter Property="BorderBrush" Value="{StaticResource UA.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Effect" Value="{StaticResource UA.Shadow.Soft}" />
    </Style>

    <!-- Barra inferior de estado -->
    <Style x:Key="UA.StatusBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UA.Brush.BgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource UA.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- Encabezado de sección -->
    <Style x:Key="UA.SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource UA.Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="4,2,4,10" />
    </Style>

    <!-- Marca / logotipo tipográfico -->
    <Style x:Key="UA.BrandMark" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource UA.Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Chip de estado (mensajes/notificaciones en la barra inferior) -->
    <Style x:Key="UA.StatusChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UA.Brush.BgElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource UA.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- DataGrid (tabla de archivos) -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource UA.Brush.TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#0F192B" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource UA.Brush.StrokeSoft}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="ColumnHeaderHeight" Value="38" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource UA.Brush.TextPrimary}" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource UA.Brush.BgElevated}" />
        <Setter Property="Foreground" Value="{StaticResource UA.Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="SeparatorBrush" Value="{StaticResource UA.Brush.StrokeSoft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource UA.Brush.Stroke}" BorderThickness="0,0,0,1" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                        <Rectangle Width="1" HorizontalAlignment="Right" Fill="{StaticResource UA.Brush.StrokeSoft}" Margin="0,10" />
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="8" Opacity="0" Cursor="SizeWE" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="8" Opacity="0" Cursor="SizeWE" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource UA.Brush.BgHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource UA.Brush.TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="RowBorder" Background="{TemplateBinding Background}" Margin="0,1" CornerRadius="6"
                            BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </SelectiveScrollingGrid.ColumnDefinitions>
                            <DataGridCellsPresenter Grid.Column="1"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </SelectiveScrollingGrid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource UA.Brush.HoverFill}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource UA.Brush.SelectionFill}" />
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource UA.Brush.SelectionStroke}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TreeView (árbol de carpetas) -->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource UA.Brush.TextPrimary}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource UA.Brush.TextSecondary}" />
        <Setter Property="Padding" Value="4,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="Pill" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="Transparent" CornerRadius="6" BorderBrush="Transparent" BorderThickness="1" />

                        <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" Focusable="False" Width="18" Height="26"
                                      VerticalAlignment="Center">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Width="18" Height="18">
                                        <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8" Stroke="{StaticResource UA.Brush.TextMuted}"
                                              StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource UA.Brush.TextPrimary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Border Grid.Row="0" Grid.Column="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center" />
                        </Border>

                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="12,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource UA.Brush.HoverFill}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource UA.Brush.SelectionFill}" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource UA.Brush.SelectionStroke}" />
                            <Setter Property="Foreground" Value="{StaticResource UA.Brush.TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ProgressBar -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource UA.Brush.Accent}" />
        <Setter Property="Background" Value="#182339" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="3" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource UA.Color.Accent}" Offset="0" />
                                        <GradientStop Color="{StaticResource UA.Color.Cyan}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GridSplitter -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Rectangle Width="2" HorizontalAlignment="Center" RadiusX="1" RadiusY="1"
                                   Fill="{StaticResource UA.Brush.StrokeSoft}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar delgada -->
    <Style x:Key="UA.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="4" Background="#1F2C48" Margin="4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#33456B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource UA.ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="12" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

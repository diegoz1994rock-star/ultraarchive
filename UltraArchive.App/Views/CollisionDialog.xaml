<ui:FluentWindow
        x:Class="UltraArchive.App.Views.CollisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:UltraArchive.App.Resources"
        Title="{x:Static res:Strings.CollisionDialogTitle}"
        Icon="pack://application:,,,/UltraArchive;component/Assets/UltraArchive.ico"
        Height="256" Width="480"
        MinHeight="256" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{StaticResource UA.Brush.WindowBackground}"
        WindowCornerPreference="Round">

    <Grid Margin="0,36,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.CollisionDialogTitle}"
                     ShowMaximize="False" ShowMinimize="False" Background="Transparent"
                     VerticalAlignment="Top" Margin="0,-36,0,0" />

        <Border Grid.Row="1" Style="{StaticResource UA.Card}" Margin="16,4,16,16" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:SymbolIcon Symbol="Warning24" Foreground="{StaticResource UA.Brush.Danger}" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static res:Strings.CollisionDialogTitle}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource UA.Brush.TextPrimary}" />
                </StackPanel>

                <TextBlock Grid.Row="1" x:Name="PromptText" Margin="0,0,0,12" TextWrapping="Wrap"
                           Foreground="{StaticResource UA.Brush.TextSecondary}" />

                <CheckBox Grid.Row="2" x:Name="ApplyToAllCheck" Margin="0,0,0,14"
                          Content="{x:Static res:Strings.CollisionDialogApplyToAll}" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{x:Static res:Strings.CollisionDialogCancel}" Margin="0,0,8,0" Padding="14,6" Click="Cancel_Click" />
                    <ui:Button Content="{x:Static res:Strings.CollisionDialogSkip}" Margin="0,0,8,0" Padding="14,6" Click="Skip_Click" />
                    <ui:Button Content="{x:Static res:Strings.CollisionDialogRename}" Margin="0,0,8,0" Padding="14,6" Click="Rename_Click" />
                    <ui:Button Content="{x:Static res:Strings.CollisionDialogOverwrite}" Appearance="Primary" Padding="16,6" Click="Overwrite_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>

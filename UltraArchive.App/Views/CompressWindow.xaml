<ui:FluentWindow
        x:Class="UltraArchive.App.Views.CompressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:UltraArchive.App.Resources"
        xmlns:conv="clr-namespace:UltraArchive.App.Converters"
        xmlns:s="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{x:Static res:Strings.CompressWindowTitle}"
        Icon="pack://application:,,,/UltraArchive;component/Assets/UltraArchive.ico"
        Height="680" Width="680" MinHeight="560" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{StaticResource UA.Brush.WindowBackground}"
        WindowCornerPreference="Round"
        AllowDrop="True"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <ui:FluentWindow.Resources>
        <s:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </ui:FluentWindow.Resources>

    <Grid Margin="0,36,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.CompressWindowTitle}" Background="Transparent"
                     VerticalAlignment="Top" Margin="0,-36,0,0" />

        <ScrollViewer Grid.Row="1" Margin="16,4,16,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- Orígenes -->
            <Border Style="{StaticResource UA.Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera: título + botones de añadir/quitar (siempre visibles) -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.CompressLabelSources}" Style="{StaticResource UA.SectionHeader}"
                                   Margin="2,0,2,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="{x:Static res:Strings.CompressButtonAddFiles}" Appearance="Primary" Margin="0,0,6,0" Padding="12,5"
                                       Command="{Binding AddFilesCommand}">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentAdd24" /></ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="{x:Static res:Strings.CompressButtonAddFolder}" Margin="0,0,6,0" Padding="12,5"
                                       Command="{Binding AddFolderCommand}">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="FolderAdd24" /></ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="{x:Static res:Strings.CompressButtonRemoveSelected}" Padding="12,5" Click="RemoveSelected_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Zona de lista + arrastrar y soltar -->
                    <Border Grid.Row="1" x:Name="DropZone" AllowDrop="True" Height="150" CornerRadius="8"
                            Background="{StaticResource UA.Brush.BgInput}" BorderBrush="{StaticResource UA.Brush.StrokeSoft}" BorderThickness="1"
                            DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
                        <Grid>
                            <ListBox x:Name="SourcesListBox" ItemsSource="{Binding Sources}" SelectionMode="Extended"
                                     Background="Transparent" BorderThickness="0" Padding="2" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                        Visibility="{Binding HasSources, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="26" HorizontalAlignment="Center"
                                               Foreground="{StaticResource UA.Brush.TextMuted}" />
                                <TextBlock Text="{x:Static res:Strings.CompressDropHint}" Margin="0,8,0,0" TextAlignment="Center"
                                           Foreground="{StaticResource UA.Brush.TextMuted}" FontSize="12.5" />
                            </StackPanel>
                            <Border x:Name="DropOverlay" Visibility="Collapsed" CornerRadius="8"
                                    Background="#332F7DFF" BorderBrush="{StaticResource UA.Brush.Accent}" BorderThickness="2">
                                <TextBlock Text="{x:Static res:Strings.CompressDropOverlay}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{StaticResource UA.Brush.TextPrimary}" FontWeight="SemiBold" FontSize="14" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Destino + formato + nivel -->
            <Border Style="{StaticResource UA.Card}" Padding="14" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.CompressLabelOutput}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" Foreground="{StaticResource UA.Brush.TextSecondary}" />
                        <TextBox Grid.Column="1" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="8,7" />
                        <ui:Button Grid.Column="2" Content="{x:Static res:Strings.CompressButtonBrowseOutput}" Margin="8,0,0,0" Padding="12,5" Command="{Binding BrowseOutputCommand}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{x:Static res:Strings.CompressLabelFormat}" Margin="0,0,0,5" Foreground="{StaticResource UA.Brush.TextSecondary}" />
                            <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="IsEnabled" Value="{Binding CanCreate}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{x:Static res:Strings.CompressLabelLevel}" Margin="0,0,0,5" Foreground="{StaticResource UA.Brush.TextSecondary}" />
                            <ComboBox ItemsSource="{Binding AvailableLevels}" SelectedItem="{Binding SelectedLevel}" />
                        </StackPanel>
                    </Grid>

                    <!-- Dividir archivo en partes (solo 7Z con 7zr.exe verificado) -->
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{x:Static res:Strings.CompressLabelSplit}" Margin="0,0,0,5" Foreground="{StaticResource UA.Brush.TextSecondary}" />
                        <ComboBox ItemsSource="{Binding AvailableSplitChoices}" SelectedItem="{Binding SelectedSplitChoice}"
                                  IsEnabled="{Binding SplitAvailable}" />

                        <Grid Margin="0,8,0,0" Visibility="{Binding ShowCustomSplitSize, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.CompressLabelSplitPartSize}" VerticalAlignment="Center"
                                       Margin="0,0,10,0" Foreground="{StaticResource UA.Brush.TextSecondary}" />
                            <TextBox Grid.Column="1" Text="{Binding CustomSplitValue, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{Binding AvailableSizeUnits}" SelectedItem="{Binding CustomSplitUnit}" />
                        </Grid>

                        <Grid Margin="0,8,0,0" Visibility="{Binding ShowSplitPartCount, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.CompressLabelSplitPartCount}" VerticalAlignment="Center"
                                       Margin="0,0,10,0" Foreground="{StaticResource UA.Brush.TextSecondary}" />
                            <TextBox Grid.Column="1" Text="{Binding SplitPartCount, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                        </Grid>

                        <TextBlock Text="{x:Static res:Strings.CompressNoteSplitUnavailable}"
                                   Visibility="{Binding ShowSplitUnavailableNote, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Foreground="{StaticResource UA.Brush.TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Opciones + cifrado -->
            <Border Style="{StaticResource UA.Card}" Padding="14" Margin="0,10,0,0">
                <StackPanel>
                    <CheckBox Content="{x:Static res:Strings.CompressCheckboxPreserveStructure}" IsChecked="{Binding PreserveFolderStructure}" Margin="0,0,0,6" />
                    <CheckBox Content="{x:Static res:Strings.CompressCheckboxDeleteSource}" IsChecked="{Binding DeleteSourceAfterCompress}" Margin="0,0,0,6" />
                    <CheckBox Content="{x:Static res:Strings.CompressCheckboxEncrypt}" IsChecked="{Binding EncryptionEnabled}" Margin="0,0,0,4" />

                    <StackPanel Visibility="{Binding ShowPasswordFields, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{x:Static res:Strings.CompressLabelPassword}" Margin="0,0,0,5" Foreground="{StaticResource UA.Brush.TextSecondary}" />
                                <PasswordBox x:Name="PasswordBox" Padding="8,7" PasswordChanged="PasswordBox_PasswordChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{x:Static res:Strings.CompressLabelConfirmPassword}" Margin="0,0,0,5" Foreground="{StaticResource UA.Brush.TextSecondary}" />
                                <PasswordBox x:Name="ConfirmPasswordBox" Padding="8,7" PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{x:Static res:Strings.CompressNoteEncryptionZipNames}" Foreground="{StaticResource UA.Brush.TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>

                    <TextBlock Text="{x:Static res:Strings.CompressNoteEncryptionUnavailable}"
                               Visibility="{Binding ShowEncryptionUnavailableNote, Converter={StaticResource BoolToVisibilityConverter}}"
                               Foreground="{StaticResource UA.Brush.Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Progreso + acciones -->
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <ProgressBar DockPanel.Dock="Top" Height="4"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource UA.Brush.TextSecondary}" FontSize="12.5" />
                </DockPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{x:Static res:Strings.ButtonCancelOperation}" Margin="0,0,8,0" Padding="14,6"
                               Command="{Binding CancelOperationCommand}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ui:Button Content="{x:Static res:Strings.CompressButtonStart}" Appearance="Primary" Padding="22,7" Command="{Binding StartCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>

<ui:FluentWindow
        x:Class="UltraArchive.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:UltraArchive.App.Resources"
        Title="{x:Static res:Strings.PasswordDialogTitle}"
        Icon="pack://application:,,,/UltraArchive;component/Assets/UltraArchive.ico"
        Height="248" Width="440"
        MinHeight="248" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{StaticResource UA.Brush.WindowBackground}"
        WindowCornerPreference="Round">

    <Grid Margin="0,36,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.PasswordDialogTitle}"
                     ShowMaximize="False" ShowMinimize="False" Background="Transparent"
                     VerticalAlignment="Top" Margin="0,-36,0,0" />

        <Border Grid.Row="1" Style="{StaticResource UA.Card}" Margin="16,4,16,16" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <ui:SymbolIcon Symbol="Key24" Foreground="{StaticResource UA.Brush.Cyan}" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static res:Strings.PasswordDialogTitle}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource UA.Brush.TextPrimary}" />
                </StackPanel>

                <TextBlock Grid.Row="1" x:Name="PromptText" Margin="0,0,0,12" TextWrapping="Wrap"
                           Foreground="{StaticResource UA.Brush.TextSecondary}" />

                <PasswordBox Grid.Row="2" x:Name="PasswordBox" Padding="10,8" VerticalAlignment="Top"
                             KeyDown="PasswordBox_KeyDown" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <ui:Button Content="{x:Static res:Strings.PasswordDialogCancel}" Margin="0,0,8,0" Padding="16,6" Click="Cancel_Click" />
                    <ui:Button Content="{x:Static res:Strings.PasswordDialogOk}" Appearance="Primary" Padding="18,6" Click="Ok_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>

<ui:FluentWindow
        x:Class="UltraArchive.App.Views.ShellProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:UltraArchive.App.Resources"
        xmlns:s="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{x:Static res:Strings.ShellProgressTitleExtract}"
        Icon="pack://application:,,,/UltraArchive;component/Assets/UltraArchive.ico"
        Width="460" MinHeight="0" MinWidth="0" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{StaticResource UA.Brush.WindowBackground}"
        WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <s:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ui:FluentWindow.Resources>

    <Grid Margin="0,36,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.ShellProgressTitleExtract}" Background="Transparent"
                     VerticalAlignment="Top" Margin="0,-36,0,0" />

        <Border Grid.Row="1" Style="{StaticResource UA.Card}" Margin="14,2,14,14" Padding="16,14">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="34" Foreground="{StaticResource UA.Brush.TextPrimary}" FontSize="13" />

                <ProgressBar Height="14" Margin="0,10,0,0" Minimum="0" Maximum="100"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding ProgressPercent, Mode=OneWay}" />

                <TextBlock Text="{Binding ProgressElapsedText}" Margin="0,8,0,0"
                           Foreground="{StaticResource UA.Brush.TextMuted}" FontSize="12" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <ui:Button x:Name="BackgroundButton" Content="{x:Static res:Strings.ShellProgressButtonBackground}"
                               Padding="16,6" Margin="0,0,8,0" Click="BackgroundButton_Click" />
                    <ui:Button Content="{x:Static res:Strings.ButtonCancelOperation}" Appearance="Danger" Padding="18,6"
                               Command="{Binding CancelOperationCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
